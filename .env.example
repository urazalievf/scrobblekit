# Copy to .env (gitignored) and fill in your own values.
# Get a Last.fm API account at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# The ListenBrainz user token is not read from this file. Paste it into the
# app's settings; it is validated and stored in the Keychain.
